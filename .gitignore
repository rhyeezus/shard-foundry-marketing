# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw video masters — kept local; only the web-delivery .webm/-alpha.mp4 are committed.
# (.mov sources, plus the green-screen source .mp4s; -alpha.mp4 delivery files are re-included)
public/video/gems/*.mov
public/video/characters/*.mov
public/video/gems/*.mp4
!public/video/gems/*-alpha.mp4
